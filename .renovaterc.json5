{
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "kubernetes/apps/observability/kube-prometheus-stack/crds/kustomization.yaml",
      ],
      matchStrings: [
        "https://raw\\.githubusercontent\\.com/prometheus-community/helm-charts/kube-prometheus-stack-(?<currentValue>[0-9.]+)/",
      ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "prometheus-community/helm-charts",
      extractVersionTemplate: "^kube-prometheus-stack-(?<version>.+)$",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      managerFilePatterns: [
        "kubernetes/apps/envoy-gateway-system/envoy-gateway/crds/kustomization.yaml",
      ],
      matchStrings: [
        "https://github\\.com/envoyproxy/gateway/releases/download/(?<currentValue>v[0-9.]+)/envoy-gateway-crds\\.yaml",
      ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "envoyproxy/gateway",
      versioningTemplate: "semver",
    },
  ],
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#10.0.1",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#10.0.1",
  ],
  automergeType: "pr",
  timezone: "Asia/Shanghai",
  schedule: ["every weekend"],
  mise: {
    managerFilePatterns: ["/^\\.mise/conf\\.d/[^/]+\\.toml$/"],
  },
  packageRules: [
    {
      description: "Review identity server upgrades before applying database migrations",
      matchPackageNames: ["/(^|/)kanidm/server$/"],
      automerge: false,
    },
    {
      description: "Update monitoring chart and matching CRDs together",
      groupName: "kube-prometheus-stack",
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: [
        "ghcr.io/prometheus-community/charts/kube-prometheus-stack",
        "prometheus-community/helm-charts",
      ],
      matchUpdateTypes: ["major", "minor", "patch"],
      minimumGroupSize: 2,
    },
    {
      description: "Update Envoy controller and CRDs together",
      groupName: "envoy-gateway",
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: ["/(^|/)envoyproxy/gateway-helm$/", "envoyproxy/gateway"],
      matchUpdateTypes: ["major", "minor", "patch"],
      minimumGroupSize: 2,
    },
    {
      description: "Keep Kubernetes on 1.36.x",
      matchPackageNames: ["ghcr.io/siderolabs/kubelet"],
      allowedVersions: "/^v?1\\.36\\./",
    },
    {
      description: "Auto-merge GitHub Actions non-major updates",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
    },
    {
      description: "GitHub Actions Group",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
}
